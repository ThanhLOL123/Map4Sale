# Supabase project credentials.
# Leave unset (or delete this file's copy) to run in DEMO MODE:
# the app loads the bundled sample dataset and skips authentication.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL — Mapbox public token (pk.…) enabling the satellite basemap toggle.
# Leave unset and the map simply has no satellite button; everything else works.
# Get one at https://account.mapbox.com, and restrict it to your domains.
# VITE_MAPBOX_TOKEN=pk.your-public-token

# OPTIONAL — MapLibre style URL for the street basemap.
# The default is OpenFreeMap's CARTO-Positron style, which needs no key:
#   https://tiles.openfreemap.org/styles/positron
# Place labels are rewritten to Latin script whatever style you point this at
# (see src/map/latinLabels.ts), so Korean place names stay readable for a
# Vietnamese team. Sibling styles change the look: liberty, bright, dark, fiord.
# VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
